{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Porting: debug scalar calculation",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/devcontainer-${env:MOVING2ARM_DEV_ARCH}/dev-debug/simple_port/calculation",
      "cwd": "${workspaceFolder}",
      "args": [],
      "stopAtEntry": true,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {"text": "-enable-pretty-printing", "ignoreFailures": true},
        {"text": "set disable-randomization off"}
      ],
      "preLaunchTask": "Porting: build scalar (Debug)"
    }
  ]
}
